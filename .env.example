# Copy to .env and fill in. .env is gitignored and is read both by
# `docker compose` and by the binaries (via godotenv).
#
# One setting per variable. Passwords are never embedded in a connection string,
# so they may contain any character, including @ : / ? # % and quotes.
# Generate one with:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 24
# (alphanumeric only keeps the container healthchecks and `ps` output readable;
# it is a preference, not a parser limitation)

APP_DEV=dev
STORAGE_DIR=./tmp/uploads
PORT=8080
SIZE_LIMIT_MB=1024
ASYNQ_CONCURRENCY=2
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=video_db
DB_SSLMODE=disable
# REDIS_DB = 0 note
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# optional Redis database index, defaults to 0
# REDIS_DB=0
